{
  "entities": {
    "FoodItem": {
      "title": "Food Item",
      "description": "An item to be brought to the session",
      "type": "object",
      "properties": {
        "category": { "type": "string", "description": "The category of the food (e.g., סלט)" },
        "label": { "type": "string", "description": "Human readable label (e.g., סלט 1)" },
        "takenBy": { "type": "string", "description": "Name of the person who claimed it" },
        "claimedAt": { "type": "string", "description": "When it was claimed" },
        "claimedByUid": { "type": "string", "description": "UID of the person who claimed it" }
      },
      "required": ["category", "label"]
    },
    "MwmIntakeForm": {
      "title": "MWM Intake Form",
      "description": "Participant intake questionnaire response for Bein Levein Kochav Yair Tzur Yigal",
      "type": "object",
      "properties": {
        "fullName": { "type": "string", "description": "Full name of participant", "maxLength": 100 },
        "phone": { "type": "string", "description": "Mobile phone number", "maxLength": 50 },
        "city": { "type": "string", "description": "City of residence (optional)", "maxLength": 100 },
        "ageRange": { "type": "string", "description": "Age range selection", "maxLength": 50 },
        "motivation": { "type": "string", "description": "Reason for joining the program", "maxLength": 2000 },
        "periodCharacteristics": { "type": "array", "description": "What characterizes this period for the participant" },
        "topicsOfInterest": { "type": "array", "description": "Topics of particular interest" },
        "topicDetails": { "type": "object", "description": "Dynamic questions and expectations for each checked topic" },
        "expectations": { "type": "string", "description": "What participant hopes to gain from the program", "maxLength": 2000 },
        "notes": { "type": "string", "description": "Additional notes/info to know beforehand", "maxLength": 2000 },
        "personalWish": { "type": "string", "description": "One thing the participant wishes to have more of", "maxLength": 500 },
        "submittedAt": { "type": "string", "description": "ISO timestamp of submission" }
      },
      "required": ["fullName", "phone", "ageRange", "motivation", "expectations", "personalWish"]
    },
    "Inquiry": {
      "title": "Interest Inquiry",
      "description": "Short interest form submission from website visitors",
      "type": "object",
      "properties": {
        "fullName": { "type": "string", "description": "Full name of visitor", "maxLength": 100 },
        "phone": { "type": "string", "description": "Mobile phone number", "maxLength": 50 },
        "email": { "type": "string", "description": "Email address", "maxLength": 150 },
        "programs": { "type": "array", "description": "Selected programs of interest" },
        "notes": { "type": "string", "description": "Optional notes or message", "maxLength": 2000 },
        "submittedAt": { "type": "string", "description": "ISO timestamp of submission" },
        "source": { "type": "string", "description": "Originating page or CTA", "maxLength": 100 }
      },
      "required": ["fullName", "phone", "email"]
    },
    "PageStat": {
      "title": "Page Visit Statistic",
      "description": "Aggregated page visit counter (summary or daily) for landing pages and website routes",
      "type": "object",
      "properties": {
        "kind": { "type": "string", "enum": ["live_summary", "live_daily"], "description": "Whether this record is a lifetime summary or a daily counter", "maxLength": 20 },
        "pageKey": { "type": "string", "description": "Normalized page identifier (e.g. home, midlife-workshop, ahead-of-you)", "maxLength": 60 },
        "date": { "type": "string", "description": "YYYY-MM-DD date string for daily records", "maxLength": 20 },
        "totalVisits": { "type": "integer", "description": "Total recorded visits" },
        "uniqueVisits": { "type": "integer", "description": "Unique browser/device visits" },
        "lastVisitAt": { "type": "string", "description": "ISO timestamp of most recent visit", "maxLength": 100 }
      },
      "required": ["kind", "pageKey", "totalVisits", "uniqueVisits", "lastVisitAt"]
    },
    "PageVisitLog": {
      "title": "Page Visit Log",
      "description": "Timestamped visit event log for viewing exact visit hours by page",
      "type": "object",
      "properties": {
        "pageKey": { "type": "string", "description": "Normalized page identifier", "maxLength": 60 },
        "visitedAt": { "type": "string", "description": "ISO timestamp of visit", "maxLength": 100 },
        "isUnique": { "type": "boolean", "description": "Whether this was a first-time visit for this browser/device" },
        "deviceType": { "type": "string", "enum": ["mobile", "desktop"], "description": "Visitor device category", "maxLength": 20 }
      },
      "required": ["pageKey", "visitedAt", "isUnique", "deviceType"]
    },
    "SoulRegistration": {
      "title": "Soul Training Registration",
      "description": "Full 15-question registration submission for Bein Levein Soul Training",
      "type": "object",
      "properties": {
        "fullName": { "type": "string", "maxLength": 120 },
        "phone": { "type": "string", "maxLength": 50 },
        "email": { "type": "string", "maxLength": 150 },
        "age": { "type": "integer" },
        "maritalStatus": { "type": "string", "maxLength": 80 },
        "childrenAges": { "type": "array" },
        "trainsAtStudio": { "type": "string", "enum": ["כן", "לא"], "maxLength": 10 },
        "joinReasons": { "type": "array" },
        "joinReasonsOther": { "type": "string", "maxLength": 500 },
        "curiousTopics": { "type": "array" },
        "personalGift": { "type": "string", "maxLength": 5000 },
        "heardFrom": { "type": "string", "maxLength": 100 },
        "heardFromOther": { "type": "string", "maxLength": 500 },
        "allergies": { "type": "string", "maxLength": 500 },
        "termsAccepted": { "type": "boolean" },
        "photoConsent": { "type": "boolean" },
        "stayInTouchConsent": { "type": "boolean" },
        "paid": { "type": "boolean", "description": "Whether PayBox payment was verified by admin" },
        "paidAt": { "type": "string", "maxLength": 100 },
        "submittedAt": { "type": "string", "maxLength": 100 },
        "source": { "type": "string", "maxLength": 100 }
      },
      "required": [
        "fullName", "phone", "email", "age", "maritalStatus",
        "childrenAges", "trainsAtStudio", "joinReasons", "curiousTopics",
        "personalGift", "heardFrom", "allergies", "termsAccepted", "photoConsent",
        "stayInTouchConsent", "submittedAt", "source"
      ]
    }
  },
  "firestore": {
    "foodItems": {
      "schema": "FoodItem",
      "description": "Collection of food items for the refreshment signup"
    },
    "mwm_intake_forms": {
      "schema": "MwmIntakeForm",
      "description": "Intake questionnaire responses for Bein Levein KY"
    },
    "inquiries": {
      "schema": "Inquiry",
      "description": "Short interest inquiries from potential participants"
    },
    "page_stats": {
      "schema": "PageStat",
      "description": "Aggregated visit counters per page (summary and daily)"
    },
    "page_visit_logs": {
      "schema": "PageVisitLog",
      "description": "Timestamped page visit events showing exact hour and device type"
    },
    "soul_registrations": {
      "schema": "SoulRegistration",
      "description": "Full registration questionnaire submissions for Soul Training workshop"
    }
  }
}
